<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Renders HTML to PDF. Pages laid out by Snail.Toolkit.HtmlComposer.Engine are drawn
      onto a PDF canvas with their TrueType fonts embedded, so Cyrillic and custom faces display the same
      on every device.
    </Description>
    <PackageTags>html;pdf;skia;skiasharp;fonts</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine\Engine.csproj" />
    <ProjectReference Include="..\Fonts\Fonts.csproj" />
  </ItemGroup>

</Project>

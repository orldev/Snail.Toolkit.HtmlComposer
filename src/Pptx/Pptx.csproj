<Project Sdk="Snail.Sdk.Library">

  <PropertyGroup>
    <Description>
      Renders HTML to PowerPoint. Pages laid out by Snail.Toolkit.HtmlComposer.Engine become slides written in
      PowerPoint's own objects: tables are tables, blocks of text are text boxes holding their paragraphs, and
      the running header and footer sit on the slide layout with PowerPoint's slide number, so a deck carries
      the layout of the document and is edited like any other.
    </Description>
    <PackageTags>html;pptx;powerpoint;openxml;slides</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine\Engine.csproj" />
    <ProjectReference Include="..\Fonts\Fonts.csproj" />
  </ItemGroup>

</Project>

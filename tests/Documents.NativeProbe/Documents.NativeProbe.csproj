<Project Sdk="Snail.Sdk">

  <!--
    The libraries in a native app: IsAotCompatible sees warnings only, and a library can be clean and still lay out or
    draw nothing under Native AOT. The shared CI publishes this probe with Native AOT and runs it; it must exit 0.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Pdf\Pdf.csproj" />
    <ProjectReference Include="..\..\src\Pptx\Pptx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Assets\*.ttf" Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
